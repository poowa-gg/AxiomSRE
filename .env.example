# AxiomSRE Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production

# Nebius Token Factory (https://tokenfactory.nebius.com)
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_API_KEY=YOUR_NEBIUS_API_KEY

# NVIDIA Open Source Models on Nebius Token Factory
# Fast model for telemetry parsing and anomaly extraction
NVIDIA_FAST_MODEL=nvidia/nemotron-3-super-120b-a12b
# Ultra model for deep neuro-symbolic reasoning and causal DAG construction
NVIDIA_REASONING_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# Model for code remediation and patch generation
NVIDIA_CODE_MODEL=nvidia/nemotron-3-super-120b-a12b

# Tavily AI Search (https://tavily.com) - For real-time live grounding & external corroboration
TAVILY_API_KEY=YOUR_TAVILY_API_KEY

# Demo Mode: Set to true to enable calibrated high-fidelity telemetry fixtures when API keys are omitted
DEMO_MODE=true
